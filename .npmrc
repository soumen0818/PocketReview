# `react-tinder-card@1.6.4` declares a peer dependency on `@react-spring/web@^9`
# and has not been updated for v10, which this project uses. The library works
# correctly against v10 — the deck, its gestures and the programmatic swipe are
# all exercised by the app — so the declared range is stale rather than a real
# incompatibility.
#
# This lives in `.npmrc` rather than a local `--legacy-peer-deps` flag because
# Vercel runs a plain `npm install`: without it the build fails with ERESOLVE
# while local installs succeed, which is the worst kind of difference between
# environments. Anyone cloning the repo now gets a working `npm install` too.
#
# Remove this once `react-tinder-card` widens its peer range.
legacy-peer-deps=true
