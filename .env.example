# ─── Multi-user deployment (Vercel, or anywhere shared) ──────────────────────
# Register a GitHub OAuth App:  https://github.com/settings/developers
#   Homepage URL:                https://your-app.vercel.app
#   Authorization callback URL:  https://your-app.vercel.app/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Encrypts the session cookie holding each user's GitHub token.
# REQUIRED in production — the app refuses to start without it.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# ─── Optional ───────────────────────────────────────────────────────────────

# Explanation layer. Every score, ranking and review plan works without it —
# you lose the prose, not the system.
ANTHROPIC_API_KEY=

# Shared cache across serverless instances. Optional: without it the app keeps
# an in-memory cache per instance, so a cold start simply refetches.
#
# On Vercel you do NOT set these by hand — connect Upstash for Redis from the
# Marketplace and Vercel injects them, then redeploy. The Marketplace uses the
# KV_REST_API_* names (inherited from the sunset Vercel KV); connecting Upstash
# directly uses UPSTASH_REDIS_REST_*. The app accepts either pair.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Local single-user development ───────────────────────────────────────────
# A personal access token, used only when OAuth is NOT configured. Once
# GITHUB_CLIENT_ID is set this is ignored — a shared token on a multi-user
# deployment would let any visitor browse your private repositories.
# Fine-grained token, read-only: Contents, Pull requests, Checks, Commit statuses.
GITHUB_TOKEN=

# Serve captured fixtures instead of live GitHub data. Safe to make public:
# no credentials are used and nothing private is reachable.
DEMO_MODE=
