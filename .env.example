# GitHub access — required.
# A personal access token with `repo:read` scope is enough. PocketReview never
# writes: there is no merge or approve call anywhere in the codebase.
GITHUB_TOKEN=

# Anthropic API key — optional.
# Powers the explanation layer only. Every score, ranking and review plan is
# computed deterministically without it; omit this and you lose the prose,
# not the system.
ANTHROPIC_API_KEY=

# Serve captured fixtures instead of live GitHub data.
# Set to 1 to run the full application with no network access.
DEMO_MODE=
